# Скопируйте этот файл в .env и оставьте один из вариантов.
# Подойдёт любой сервис с OpenAI-совместимым API.

# Локально через Ollama, ключ не нужен. Сначала: ollama pull qwen2.5:7b
# Для ноутбука с 16 ГБ памяти берите модели до 7–8B, более крупные его вешают.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...

# OpenRouter: Claude, Gemini, DeepSeek и другие по одному ключу (список моделей: openrouter.ai/models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_API_KEY=sk-or-...

# Необязательные настройки.
# Для reasoning-моделей OpenAI (o-серия, gpt-5) оставьте температуру и лимит токенов пустыми: они их не принимают.
LLM_TEMPERATURE=0.3
# Лимит длины ответа. Карточке хватает 1000–1500 токенов, лимит обрывает модель, если она зациклилась.
LLM_MAX_TOKENS=2500
# Сколько секунд ждать ответа; локальным моделям на ноутбуке может понадобиться несколько минут.
LLM_TIMEOUT=300
